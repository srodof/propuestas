---
import type { CollectionEntry } from 'astro:content';
import Icon from '../components/Icon.astro';
import { agencias, nombresClientes } from '../data/agencia';
import { textos } from '../data/textos';

interface Props {
  data: CollectionEntry<'propuestas'>['data'];
}

const { data } = Astro.props;
const t = textos[data.idioma];
const agencia = agencias[data.idioma];
const fmt = new Intl.DateTimeFormat(t.locale, { day: 'numeric', month: 'long', year: 'numeric' });
const vence = new Date(data.fecha);
vence.setDate(vence.getDate() + data.vigenciaDias);
const mes = new Intl.DateTimeFormat(t.locale, { month: 'long', timeZone: 'UTC' }).format(data.fecha);
const mesAnio = `${mes.charAt(0).toUpperCase()}${mes.slice(1)} ${data.fecha.getUTCFullYear()}`;
const ver = (s: string) => !data.ocultar.includes(s as never);
const dos = (n: number) => String(n + 1).padStart(2, '0');
const slug = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const { contacto } = agencia;
const mensaje = encodeURIComponent(t.mensajeWhatsapp(data.titulo, data.cliente));
const whatsapp = `https://wa.me/${contacto.whatsapp}?text=${mensaje}`;
// Texto con **negritas**: se escapa el HTML y solo se convierte el doble asterisco
const negritas = (t: string) =>
  t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const logo = (id: string) => ({ src: `/clientes/${id}.webp`, alt: nombresClientes[id] ?? id });

const nav = [
  ver('nosotros') && { href: '#nosotros', label: t.nav.nosotros },
  { href: '#situacion', label: t.nav.situacion },
  data.modulos.length > 0 && { href: '#propuesta', label: t.nav.propuesta },
  data.kickoff.length > 0 && { href: '#kickoff', label: t.nav.kickoff },
  { href: '#inversion', label: t.nav.inversion },
  { href: '#contacto', label: t.nav.contacto },
].filter(Boolean) as { href: string; label: string }[];
---
<!doctype html>
<html lang={data.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{data.titulo} · {data.cliente} · SWIITCH</title>
    <link rel="icon" type="image/png" href="/marca/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="preload" href="/fonts/Heavitas.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="progreso" aria-hidden="true"><span></span></div>

    <!-- Menú fijo: transparente sobre el hero, blanco al hacer scroll -->
    <header class="nav" data-nav>
      <div class="nav__in">
        <a class="nav__logo" href="#inicio" aria-label={t.irInicio}>
          <img src="/marca/swiitch-rojo.png" alt="SWIITCH" width="132" height="40" />
        </a>
        <nav class="nav__links" id="menu" aria-label={t.secciones}>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a class="btn btn--sm nav__cta" href={whatsapp} target="_blank" rel="noopener">
            {t.aceptar} <Icon name="chevron-right" size={18} />
          </a>
        </nav>
        <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label={t.abrirMenu} data-menu>
          <Icon name="menu" />
        </button>
      </div>
    </header>

    <main>
      <!-- 1. Hero -->
      <section class="hero" id="inicio">
        <div class="wrap hero__grid">
          <div class="hero__texto">
            <p class="eyebrow eyebrow--dark" data-reveal="left">
              <span class="switch" aria-hidden="true"><span></span></span>
              {t.propuestaPara} {data.cliente}
            </p>
            <h1 class="hero__titulo" data-reveal="up" style="--d:120ms">{data.titulo}</h1>
            {data.bajada && <p class="hero__bajada" data-reveal="up" style="--d:240ms">{data.bajada}</p>}
            <p class="hero__meta" data-reveal="up" style="--d:320ms">
              {mesAnio}
            </p>
          </div>
          {data.imagenHero && (
            <div class="hero__media" data-reveal="right" style="--d:200ms">
              <div class="foto foto--acento">
                <img src={data.imagenHero} alt={data.cliente} width="800" height="600" fetchpriority="high" />
              </div>
              {data.logoCliente && (
                <div class="hero__logo"><img src={data.logoCliente} alt={t.logoDe(data.cliente)} /></div>
              )}
            </div>
          )}
        </div>
      </section>

      <!-- Diferenciales de SWIITCH: tarjetas que suben sobre el hero -->
      <div class="wrap resumen" aria-label={t.porQue}>
        {agencia.diferenciales.map((d, i) => (
          <article class="tarjeta tarjeta--fill" tabindex="0" data-reveal="up" style={`--d:${i * 120}ms`}>
            <span class="tarjeta__icono"><Icon name={d.icono} size={44} stroke={1.5} /></span>
            <h3>{d.titulo}</h3>
            <p>{d.texto}</p>
          </article>
        ))}
      </div>

      <!-- 2. Nosotros -->
      {ver('nosotros') && (
        <section class="seccion" id="nosotros">
          <div class="wrap dos-col">
            <div class="nosotros__media" data-reveal="left">
              <div class="foto foto--acento foto--izq">
                <img src={agencia.nosotros.imagen} alt={t.fotoEquipo} loading="lazy" />
              </div>
              <div class="sello">
                <strong data-count="15">15</strong><span>+</span>
                <small>{t.anios}</small>
              </div>
            </div>
            <div>
              <p class="eyebrow" data-reveal="right">{t.quienesSomos}</p>
              <h2 data-reveal="up">{agencia.nosotros.titulo}</h2>
              <p class="texto" data-reveal="up">{agencia.nosotros.quienesSomos}</p>
              <p class="texto" data-reveal="up">{agencia.nosotros.queHacemos}</p>
              <blockquote class="cita" data-reveal="up">{agencia.nosotros.mision}</blockquote>
            </div>
          </div>
        </section>
      )}

      <!-- Franja de cifras -->
      {ver('cifras') && (
        <section class="cifras" aria-label={t.enCifras}>
          <div class="wrap cifras__grid">
            {agencia.cifras.map((c, i) => (
              <div class="cifra" data-reveal="up" style={`--d:${i * 100}ms`}>
                <p class="cifra__num"><span data-count={c.valor}>{c.valor}</span><em>{c.sufijo}</em></p>
                <p class="cifra__label">{c.etiqueta}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 3. Servicios de la agencia -->
      {ver('servicios') && (
        <section class="seccion" id="servicios">
          <div class="wrap">
            <div class="cabecera">
              <div>
                <p class="eyebrow" data-reveal="left">{t.nuestrosServicios}</p>
                <h2 data-reveal="up">{t.todoLoQue}</h2>
              </div>
            </div>
            <div class="grid-3">
              {agencia.servicios.map((s, i) => (
                <article class="tarjeta tarjeta--fill" data-reveal="up" style={`--d:${i * 120}ms`}>
                  <span class="tarjeta__icono"><Icon name={s.icono} size={44} stroke={1.5} /></span>
                  <h3>{s.area}</h3>
                  <ul class="lista-simple">{s.items.map((it) => <li>{it}</li>)}</ul>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- 4. Clientes -->
      {ver('clientes') && (
        <section class="clientes" aria-labelledby="t-clientes">
          <div class="wrap">
            <p class="eyebrow eyebrow--centro" id="t-clientes" data-reveal="down">{t.algunosClientes}</p>
          </div>
          <div class="marquesina" data-reveal="up">
            <div class="marquesina__pista">
              {[0, 1].map((copia) =>
                agencia.clientes.map((id) => (
                  <img src={logo(id).src} alt={copia ? '' : logo(id).alt} aria-hidden={copia ? 'true' : undefined} loading="lazy" />
                )),
              )}
            </div>
          </div>
        </section>
      )}

      <!-- 5. Cómo trabajamos -->
      {ver('metodo') && (
        <section class="seccion seccion--alt" id="metodo">
          <div class="wrap">
            <p class="eyebrow" data-reveal="left">{t.comoTrabajamos}</p>
            <h2 data-reveal="up">{t.unMetodo}</h2>
            <ol class="metodo">
              {agencia.metodo.map((m, i) => (
                <li data-reveal="up" style={`--d:${i * 140}ms`}>
                  <span class="metodo__icono"><Icon name={m.icono} size={56} stroke={1.5} /></span>
                  <span class="metodo__num">{dos(i)}</span>
                  <h3>{m.titulo}</h3>
                  <p>{m.texto}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )}

      <!-- 6. Situación actual -->
      <section class="seccion" id="situacion">
        <div class="wrap estrecho">
          <p class="eyebrow" data-reveal="left">{t.situacion}</p>
          <h2 data-reveal="up">{t.dondeEsta(data.cliente)}</h2>
          {data.situacion.map((p) => <p class="texto" data-reveal="up" set:html={negritas(p)} />)}
          {data.cita && <blockquote class="cita cita--grande" data-reveal="up" set:html={negritas(data.cita)} />}
        </div>
      </section>

      <!-- 7. Requerimiento -->
      <section class="banda" style={data.imagenRequerimiento ? `--foto:url(${data.imagenRequerimiento})` : undefined}>
        <div class="wrap estrecho">
          <p class="eyebrow eyebrow--dark" data-reveal="left">{t.requerimiento}</p>
          <p class="banda__texto" data-reveal="up">{data.requerimiento}</p>
        </div>
      </section>

      <!-- 8. Propuesta: un módulo por servicio -->
      {data.modulos.length > 0 && (
        <section class="seccion" id="propuesta">
          <div class="wrap">
            <p class="eyebrow" data-reveal="left">{t.nuestraPropuesta}</p>
            <h2 data-reveal="up">{t.loQueHaremos}</h2>
          </div>
          {data.modulos.map((m, i) => {
            // Estrategia, enfoque y los bloques libres se muestran igual, alternando el rojo
            const textos = [
              m.estrategia && { titulo: t.estrategia, texto: m.estrategia },
              m.enfoque && { titulo: t.enfoque, texto: m.enfoque },
              ...(m.bloques ?? []),
            ].filter(Boolean) as { titulo: string; texto: string }[];
            return (
            <article class:list={['modulo', { 'modulo--inv': i % 2 === 1 }]} id={slug(m.titulo)}>
              <div class="wrap">
                <div class:list={['modulo__cabeza', m.imagen ? 'dos-col' : 'modulo__cabeza--sola']}>
                  {m.imagen && (
                    <div class="modulo__media" data-reveal={i % 2 ? 'right' : 'left'}>
                      <div class:list={['foto', 'foto--acento', { 'foto--izq': i % 2 === 0, 'foto--recorte': m.imagen.endsWith('.webp') }]}>
                        <img src={m.imagen} alt="" loading="lazy" />
                      </div>
                    </div>
                  )}
                  <div>
                    <p class="modulo__num" data-reveal="up">{dos(i)}</p>
                    <h3 class="modulo__titulo" data-reveal="up">{m.titulo}</h3>
                    {m.subtitulo && <p class="modulo__sub" data-reveal="up">{m.subtitulo}</p>}
                    {m.plazo && <p class="modulo__plazo" data-reveal="up"><Icon name="clock" size={18} />{m.plazo}</p>}
                    <div class="bloques">
                      {textos.map((b, k) => (
                        <div class:list={['bloque', { 'bloque--rojo': k % 2 === 1 }]} data-reveal="up">
                          <h4>{b.titulo}</h4>
                          <p>{b.texto}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                {m.incluye.length > 0 && (
                  <div class="incluye">
                    <h4 class="sub" data-reveal="up">{t.queIncluye}</h4>
                    <ul class="checks">
                      {m.incluye.map((it, k) => (
                        <li data-reveal="up" style={`--d:${(k % 6) * 70}ms`}><Icon name="check" size={20} />{it}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {m.alcance && m.alcance.length > 0 && (
                  <div class="extra">
                    <h4 class="sub" data-reveal="up">{t.alcance}</h4>
                    <ul class="alcance">
                      {m.alcance.map((a, k) => (
                        <li data-reveal="up" style={`--d:${(k % 6) * 70}ms`}>
                          <strong>{a.titulo}</strong>
                          {a.detalle && <p>{a.detalle}</p>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {m.proceso && (
                  <div class="extra">
                    <h4 class="sub" data-reveal="up">{m.proceso.titulo}</h4>
                    {m.proceso.texto && <p class="texto estrecho-izq" data-reveal="up">{m.proceso.texto}</p>}
                    <ol class="pasos">
                      {m.proceso.pasos.map((p, k) => (
                        <li data-reveal="up" style={`--d:${k * 120}ms`}><span>{k + 1}</span>{p}</li>
                      ))}
                    </ol>
                  </div>
                )}

                {m.checklist && (
                  <div class="extra">
                    <h4 class="sub" data-reveal="up">{m.checklist.titulo}</h4>
                    {m.checklist.texto && <p class="texto estrecho-izq" data-reveal="up">{m.checklist.texto}</p>}
                    <ul class="checks checks--una">
                      {m.checklist.items.map((it, k) => (
                        <li data-reveal="left" style={`--d:${k * 60}ms`}><Icon name="check" size={20} />{it}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {m.comparativa && (
                  <div class="extra">
                    <h4 class="sub" data-reveal="up">{m.comparativa.titulo}</h4>
                    {m.comparativa.texto && <p class="texto estrecho-izq" data-reveal="up">{m.comparativa.texto}</p>}
                    <div class="tabla" data-reveal="up">
                      <table>
                        <thead><tr>{m.comparativa.columnas.map((c) => <th scope="col">{c}</th>)}</tr></thead>
                        <tbody>
                          {m.comparativa.filas.map((f) => (
                            <tr>{f.map((c, k) => (k === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}

                {m.galeria && (
                  <div class="extra">
                    <h4 class="sub" data-reveal="up">{m.galeria.titulo}</h4>
                    {m.galeria.texto && <p class="texto estrecho-izq" data-reveal="up">{m.galeria.texto}</p>}
                    <div class="galeria">
                      {m.galeria.fotos.map((src, k) => (
                        <img src={src} alt="" loading="lazy" data-reveal="up" style={`--d:${k * 100}ms`} />
                      ))}
                    </div>
                  </div>
                )}

                {m.casos && (
                  <div class="extra">
                    <h4 class="sub" data-reveal="up">{m.casos.titulo}</h4>
                    {m.casos.texto && <p class="texto estrecho-izq" data-reveal="up">{m.casos.texto}</p>}
                    <div class="casos">
                      {m.casos.logos.map((id, k) => (
                        <img src={logo(id).src} alt={logo(id).alt} loading="lazy" data-reveal="down" style={`--d:${k * 80}ms`} />
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </article>
            );
          })}
        </section>
      )}

      <!-- 9. Kick off -->
      {data.kickoff.length > 0 && (
        <section class="seccion kickoff" id="kickoff">
          <div class="wrap">
            <p class="eyebrow eyebrow--dark" data-reveal="left">{t.kickoff}</p>
            <h2 data-reveal="up">{t.pasosInicio}</h2>
            <ol class="kickoff__pasos">
              {data.kickoff.map((k, i) => (
                <li data-reveal="up" style={`--d:${(i % 4) * 110}ms`}>
                  <span class="kickoff__num">{dos(i)}</span>
                  <strong>{k.titulo}</strong>
                  {k.detalle && <p>{k.detalle}</p>}
                </li>
              ))}
            </ol>
          </div>
        </section>
      )}

      <!-- 10. Inversión -->
      <section class="seccion seccion--alt" id="inversion">
        <div class="wrap">
          <div class="cabecera">
            <div>
              <p class="eyebrow" data-reveal="left">{t.inversion}</p>
              <h2 data-reveal="up">{t.planes}</h2>
            </div>
            <p class="texto cabecera__lado" data-reveal="up">{t.validaHasta(fmt.format(vence))}</p>
          </div>
          <div class="precios">
            {data.inversion.items.map((it, i) => (
              <article class:list={['precio', { 'precio--destacado': it.destacado }]} data-reveal="up" style={`--d:${i * 120}ms`}>
                <p class="precio__servicio">{it.servicio}</p>
                <h3>{it.concepto}</h3>
                <p class="precio__monto">
                  {!it.monto.endsWith('%') && <small>{data.inversion.moneda}</small>}
                  <span>{it.monto}</span>
                  {it.periodo && <small>{it.periodo}</small>}
                </p>
                {it.incluye.length > 0 && (
                  <ul>{it.incluye.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
                )}
              </article>
            ))}
          </div>
          {data.inversion.notas.length > 0 && (
            <ul class="notas" data-reveal="up">{data.inversion.notas.map((n) => <li>{n}</li>)}</ul>
          )}
        </div>
      </section>

      <!-- 11. Cierre -->
      <section class="banda banda--cierre" id="contacto" style={data.imagenHero ? `--foto:url(${data.imagenHero})` : undefined}>
        <div class="wrap centro">
          <p class="eyebrow eyebrow--dark eyebrow--centro" data-reveal="down">{t.conversemos}</p>
          <h2 class="display" data-reveal="up">{t.avanzamos}</h2>
          <p class="banda__bajada" data-reveal="up">{t.cuentanos}</p>
          <div class="cierre__ctas" data-reveal="up">
            <a class="btn btn--slider" href={whatsapp} target="_blank" rel="noopener">
              {t.aceptarWhatsapp} <Icon name="chevron-right" size={20} />
            </a>
            <a class="enlace-claro" href={`mailto:${contacto.email}?subject=${encodeURIComponent(t.asuntoCorreo(data.cliente))}`}>
              <Icon name="mail" size={18} /> {contacto.email}
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="wrap pie__grid">
        <div>
          <img class="pie__logo" src="/marca/swiitch-footer-rojo.png" alt="SWIITCH" width="160" height="43" loading="lazy" />
          <p>{t.pieLema}</p>
        </div>
        <div>
          <p class="pie__titulo">{t.oficina}</p>
          <p class="pie__dato"><Icon name="map-pin" size={18} /><span>{contacto.direccion.map((l) => <>{l}<br /></>)}</span></p>
        </div>
        <div>
          <p class="pie__titulo">{t.contacto}</p>
          <p class="pie__dato"><Icon name="phone" size={18} /><a href={`tel:+${contacto.telefono.replace(/\D/g, '')}`}>{contacto.telefono}</a></p>
          <p class="pie__dato"><Icon name="mail" size={18} /><a href={`mailto:${contacto.email}`}>{contacto.email}</a></p>
          <p class="pie__dato"><Icon name="arrow-up-right" size={18} /><a href={contacto.web} target="_blank" rel="noopener">{new URL(contacto.web).host.replace(/^www\./, '')}</a></p>
        </div>
      </div>
      <div class="wrap pie__base">
        <span>{contacto.oficinas.join(' · ')}</span>
        <span>{t.confidencial(data.cliente)}</span>
      </div>
    </footer>

    <a class="fab" href={whatsapp} target="_blank" rel="noopener" aria-label={t.escribirWhatsapp}>
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35M12.05 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.29A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>
    </a>

    <script is:inline>
      (() => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Entradas al hacer scroll (fade + desplazamiento corto, como la referencia)
        const items = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('visible'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
