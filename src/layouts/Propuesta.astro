      .precio ul { list-style: none; padding: 20px 0 0; margin: auto 0 0; border-top: 1px solid #eee; }
      .precio li { display: flex; gap: 10px; align-items: flex-start; padding: 5px 0; font-size: 15px; line-height: 1.5; }
      .precio li svg { flex: none; color: var(--primary); margin-top: 2px; }
      .precio--destacado { background: var(--primary); color: #fff; }
      .precio--destacado h3, .precio--destacado .precio__servicio, .precio--destacado .precio__monto, .precio--destacado .precio__monto span, .precio--destacado li svg { color: #fff; }
      .precio--destacado ul { border-color: rgba(255, 255, 255, 0.35); }
      @media (min-width: 1025px) { .precio--destacado { transform: translateY(-12px); } }
      .notas { margin: 2.5rem 0 0; padding-left: 1.25rem; font-size: 14px; line-height: 1.7; max-width: 900px; }
      .notas li + li { margin-top: 6px; }

      /* Pie */
      .pie { background: var(--oscuro); color: #d0d0d0; padding: 64px 0 24px; font-size: 14.4px; }
      .pie__grid { display: grid; gap: 40px; }
      @media (min-width: 768px) { .pie__grid { grid-template-columns: 1.3fr 1fr 1fr; } }
      .pie__logo { width: 150px; height: auto; margin-bottom: 16px; }
      .pie p { margin: 0 0 8px; }
      .pie__titulo { font: 700 16px/1.4 var(--font-sans); color: #fff; margin-bottom: 14px !important; }
      .pie__dato { display: flex; gap: 10px; align-items: flex-start; }
      .pie__dato svg { flex: none; color: var(--primary); margin-top: 4px; }
      .pie a { color: #fff; text-decoration: none; }
      .pie a:hover { text-decoration: underline; text-underline-offset: 4px; }
      .pie__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 48px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 13px; color: #9e9e9e; }

      /* Botón flotante de WhatsApp */
      .fab { position: fixed; right: 20px; bottom: 20px; z-index: 40; width: 56px; height: 56px; border-radius: 9999px; background: var(--primary); color: #fff; display: grid; place-items: center; transition: background-color 0.15s ease; }
      .fab:hover { background: var(--primary-hover); }
    </style>
