---
import { getCollection } from 'astro:content';
import Propuesta from '../layouts/Propuesta.astro';

export async function getStaticPaths() {
  const propuestas = await getCollection('propuestas');
  return propuestas.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
---
<Propuesta data={p.data} />
